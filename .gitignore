*.tfvars
*.tfvars.json
!*.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan output
*tfplan*

# Lock info
.terraform.tfstate.lock.info
.vscode/mcp.json

*scripts/