<!--
  MCP Hub policy - THIN aggregator. Server-specific complexity (ACL evaluation, tool
  filtering, OBO, per-server rate limits) lives in the per-server APIM APIs
  (<gateway>/${servers_path_prefix}/<name>/mcp, modules/azurerm/apim_mcp_server); this
  policy only:
    - answers initialize / ping / notifications/* locally
    - validates the caller's Entra token + applies the hub-wide per-user rate limit
    - tools/list  -> broadcast fan-out to EVERY per-server API (user token forwarded,
                     X-MCP-Internal-Key added); servers answer 403 when the caller has
                     no entitlement and pre-filtered bare-name lists otherwise; the hub
                     drops >=400 responses, prefixes (<server>__<tool>), merges, and
                     caches the merged list per user for ${tools_cache_seconds}s
    - tools/call  -> parse the prefix, un-prefix the tool name, proxy to that server's
                     API (which re-checks the ACL and does OBO); unknown prefix -> -32602
    - everything else -> -32601

  The per-server hop goes through the gateway's public hostname (send-request /
  set-backend-service cannot dispatch internally) - one extra TLS round-trip per server,
  and each server API gets its own App Insights request telemetry.

  Template variables:
    gateway_url, rate_limit_calls, rate_limit_period, tools_cache_seconds,
    servers_path_prefix, server_names = set/list of server keys (prefixes)
-->
<policies>
  <inbound>
    <base />
    <set-variable name="mcpServer" value="hub" />
    <!-- Streamable-HTTP spec: GET (SSE stream) and DELETE (session termination) are
         not supported by the hub and MUST answer 405 - anything else (e.g. a 404)
         makes clients treat the transport as broken and loop on initialize. -->
    <choose>
      <when condition="@(context.Request.Method != &quot;POST&quot;)">
        <return-response>
          <set-status code="405" reason="Method Not Allowed" />
          <set-header name="Allow" exists-action="override">
            <value>POST</value>
          </set-header>
        </return-response>
      </when>
    </choose>
    <!-- 401 challenge with PRM discovery pointer -->
    <choose>
      <when condition="@(!context.Request.Headers.ContainsKey(&quot;Authorization&quot;))">
        <return-response>
          <set-status code="401" reason="Unauthorized" />
          <set-header name="WWW-Authenticate" exists-action="override">
            <value>Bearer resource_metadata="${gateway_url}/.well-known/oauth-protected-resource"</value>
          </set-header>
        </return-response>
      </when>
    </choose>
    <!-- Shared token validation (mcp-validate-token fragment, also included by every
         per-server policy): tenant + both audience forms; sets jwt + callerOid. -->
    <include-fragment fragment-id="mcp-validate-token" />
    <rate-limit-by-key calls="${rate_limit_calls}" renewal-period="${rate_limit_period}" counter-key="@((string)context.Variables[&quot;callerOid&quot;])" remaining-calls-variable-name="remainingCallsPerUser" />

    <!-- Parse the JSON-RPC envelope once -->
    <set-variable name="rpcBody" value="@(context.Request.Body.As&lt;JObject&gt;(preserveContent: true))" />
    <set-variable name="rpcMethod" value="@((string)((JObject)context.Variables[&quot;rpcBody&quot;])[&quot;method&quot;] ?? &quot;&quot;)" />
    <set-variable name="rpcId" value="@((((JObject)context.Variables[&quot;rpcBody&quot;])[&quot;id&quot;] ?? JValue.CreateNull()).ToString(Newtonsoft.Json.Formatting.None))" />

    <choose>
      <!-- ============ initialize: answered locally ============ -->
      <when condition="@((string)context.Variables[&quot;rpcMethod&quot;] == &quot;initialize&quot;)">
        <return-response>
          <set-status code="200" reason="OK" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>@{
              var req = (JObject)context.Variables["rpcBody"];
              var pv  = (string)(req["params"]?["protocolVersion"]) ?? "2025-06-18";
              return new JObject {
                  ["jsonrpc"] = "2.0",
                  ["id"]      = req["id"],
                  ["result"]  = new JObject {
                      ["protocolVersion"] = pv,
                      ["capabilities"]    = new JObject { ["tools"] = new JObject { ["listChanged"] = false } },
                      ["serverInfo"]      = new JObject { ["name"] = "apim-mcp-hub", ["version"] = "0.2.0" }
                  }
              }.ToString(Newtonsoft.Json.Formatting.None);
          }</set-body>
        </return-response>
      </when>

      <!-- ============ notifications (incl. notifications/initialized): 202, no body ============ -->
      <when condition="@(((string)context.Variables[&quot;rpcMethod&quot;]).StartsWith(&quot;notifications/&quot;))">
        <return-response>
          <set-status code="202" reason="Accepted" />
        </return-response>
      </when>

      <!-- ============ ping ============ -->
      <when condition="@((string)context.Variables[&quot;rpcMethod&quot;] == &quot;ping&quot;)">
        <return-response>
          <set-status code="200" reason="OK" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>@("{\"jsonrpc\":\"2.0\",\"id\":" + (string)context.Variables["rpcId"] + ",\"result\":{}}")</set-body>
        </return-response>
      </when>

      <!-- ============ tools/list: broadcast fan-out + merge + prefix ============ -->
      <when condition="@((string)context.Variables[&quot;rpcMethod&quot;] == &quot;tools/list&quot;)">
        <!-- Per-user merged-list cache. Entitlement filtering happens in the servers,
             so the hub can only key on the caller; ACL edits therefore take up to
             tools_cache_seconds (hub) + tools_cache_seconds (server) to reach clients. -->
        <cache-lookup-value key="@(&quot;hub-tools-&quot; + (string)context.Variables[&quot;callerOid&quot;])" variable-name="cachedTools" />
        <choose>
          <when condition="@(context.Variables.ContainsKey(&quot;cachedTools&quot;))">
            <return-response>
              <set-status code="200" reason="OK" />
              <set-header name="Content-Type" exists-action="override">
                <value>application/json</value>
              </set-header>
              <set-body>@("{\"jsonrpc\":\"2.0\",\"id\":" + (string)context.Variables["rpcId"] + ",\"result\":{\"tools\":" + (string)context.Variables["cachedTools"] + "}}")</set-body>
            </return-response>
          </when>
        </choose>

        <!-- Broadcast to every per-server API. Denied (403), failing, or down servers
             simply drop out of the merged list (ignore-error + >=400 filter). -->
        <wait for="all">
%{ for name in server_names ~}
          <send-request mode="new" response-variable-name="list-${name}" timeout="30" ignore-error="true">
            <set-url>${gateway_url}/${servers_path_prefix}/${name}/mcp</set-url>
            <set-method>POST</set-method>
            <set-header name="Content-Type" exists-action="override">
              <value>application/json</value>
            </set-header>
            <set-header name="Accept" exists-action="override">
              <value>application/json</value>
            </set-header>
            <set-header name="Authorization" exists-action="override">
              <value>@(context.Request.Headers.GetValueOrDefault("Authorization", ""))</value>
            </set-header>
            <set-header name="X-MCP-Internal-Key" exists-action="override">
              <value>{{mcp-hub-internal-key}}</value>
            </set-header>
            <set-body>@("{\"jsonrpc\":\"2.0\",\"id\":" + (string)context.Variables["rpcId"] + ",\"method\":\"tools/list\",\"params\":{}}")</set-body>
          </send-request>
%{ endfor ~}
        </wait>

        <!-- Debug (toggle: mcp-hub-debug named value): per-server fan-out status.
             403 = no entitlement, 502 = OBO failure at the server, no-response = down. -->
        <choose>
          <when condition="@(&quot;{{mcp-hub-debug}}&quot; == &quot;true&quot;)">
            <trace source="MCP Hub" severity="information">
              <message>MCP hub tools/list fan-out (debug)</message>
              <metadata name="mcp-server" value="hub" />
              <metadata name="caller-oid" value="@((string)context.Variables[&quot;callerOid&quot;])" />
              <metadata name="fanout-results" value="@{
                  var sb = new System.Text.StringBuilder();
%{ for name in server_names ~}
                  {
                    var status = &quot;no-response&quot;;
                    if (context.Variables.ContainsKey(&quot;list-${name}&quot;)) { var r = (IResponse)context.Variables[&quot;list-${name}&quot;]; if (r != null) { status = r.StatusCode.ToString(); } }
                    sb.Append(&quot;${name}:&quot;).Append(status).Append(&quot;; &quot;);
                  }
%{ endfor ~}
                  return sb.ToString();
              }" />
            </trace>
          </when>
        </choose>

        <!-- Merge + prefix (<server>__<tool>). Servers already filtered and return
             plain JSON with bare tool names. -->
        <set-variable name="mergedTools" value="@{
            var merged = new JArray();
            var buckets = new System.Collections.Generic.List&lt;System.Tuple&lt;string, string&gt;&gt;();
%{ for name in server_names ~}
            if (context.Variables.ContainsKey(&quot;list-${name}&quot;)) {
                var r = (IResponse)context.Variables[&quot;list-${name}&quot;];
                if (r != null &amp;&amp; r.StatusCode &lt; 400) { buckets.Add(System.Tuple.Create(&quot;${name}&quot;, r.Body.As&lt;string&gt;(preserveContent: true))); }
            }
%{ endfor ~}
            foreach (var b in buckets) {
                JObject parsed = null;
                try { parsed = JObject.Parse(b.Item2 ?? &quot;&quot;); } catch (Exception) { continue; }
                var tools = parsed[&quot;result&quot;]?[&quot;tools&quot;] as JArray; if (tools == null) { continue; }
                foreach (var t in tools) {
                    var clone = (JObject)t.DeepClone();
                    clone[&quot;name&quot;] = b.Item1 + &quot;__&quot; + (string)t[&quot;name&quot;];
                    merged.Add(clone);
                }
            }
            return merged.ToString(Newtonsoft.Json.Formatting.None);
        }" />
        <cache-store-value key="@(&quot;hub-tools-&quot; + (string)context.Variables[&quot;callerOid&quot;])" value="@((string)context.Variables[&quot;mergedTools&quot;])" duration="${tools_cache_seconds}" />
        <return-response>
          <set-status code="200" reason="OK" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>@("{\"jsonrpc\":\"2.0\",\"id\":" + (string)context.Variables["rpcId"] + ",\"result\":{\"tools\":" + (string)context.Variables["mergedTools"] + "}}")</set-body>
        </return-response>
      </when>

      <!-- ============ tools/call: un-prefix and proxy to the server's API ============ -->
      <when condition="@((string)context.Variables[&quot;rpcMethod&quot;] == &quot;tools/call&quot;)">
        <set-variable name="qualifiedTool" value="@((string)(((JObject)context.Variables[&quot;rpcBody&quot;])[&quot;params&quot;]?[&quot;name&quot;]) ?? &quot;&quot;)" />
        <set-variable name="targetServer" value="@{
            var q = (string)context.Variables[&quot;qualifiedTool&quot;];
            var idx = q.IndexOf(&quot;__&quot;);
            return idx &gt; 0 ? q.Substring(0, idx) : &quot;&quot;;
        }" />
        <set-variable name="targetTool" value="@{
            var q = (string)context.Variables[&quot;qualifiedTool&quot;];
            var idx = q.IndexOf(&quot;__&quot;);
            return idx &gt; 0 ? q.Substring(idx + 2) : &quot;&quot;;
        }" />
        <choose>
%{ for name in server_names ~}
          <when condition="@(string.Equals((string)context.Variables[&quot;targetServer&quot;], &quot;${name}&quot;, StringComparison.OrdinalIgnoreCase))">
            <!-- ACL check, rate limit, and OBO all happen in the server's policy. -->
            <set-header name="X-MCP-Internal-Key" exists-action="override">
              <value>{{mcp-hub-internal-key}}</value>
            </set-header>
            <set-body>@{
                var body = (JObject)context.Variables["rpcBody"];
                body["params"]["name"] = (string)context.Variables["targetTool"];
                return body.ToString(Newtonsoft.Json.Formatting.None);
            }</set-body>
            <set-backend-service base-url="${gateway_url}/${servers_path_prefix}/${name}" />
            <rewrite-uri template="/mcp" copy-unmatched-params="false" />
          </when>
%{ endfor ~}
          <otherwise>
            <return-response>
              <set-status code="200" reason="OK" />
              <set-header name="Content-Type" exists-action="override">
                <value>application/json</value>
              </set-header>
              <set-body>@("{\"jsonrpc\":\"2.0\",\"id\":" + (string)context.Variables["rpcId"] + ",\"error\":{\"code\":-32602,\"message\":\"Unknown or unauthorized tool: " + (string)context.Variables["qualifiedTool"] + "\"}}")</set-body>
            </return-response>
          </otherwise>
        </choose>
      </when>

      <!-- ============ everything else: method not found ============ -->
      <otherwise>
        <return-response>
          <set-status code="200" reason="OK" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>@("{\"jsonrpc\":\"2.0\",\"id\":" + (string)context.Variables["rpcId"] + ",\"error\":{\"code\":-32601,\"message\":\"Method not supported by this hub\"}}")</set-body>
        </return-response>
      </otherwise>
    </choose>
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
    <!-- Expired/invalid tokens fail validate-azure-ad-token into on-error; the MCP
         auth spec requires the RFC 9728 resource_metadata challenge on EVERY 401
         (not just the missing-header one above) so clients whose refresh token has
         also lapsed can rediscover the authorization server and restart the flow. -->
    <choose>
      <when condition="@(context.LastError?.Source == &quot;validate-azure-ad-token&quot;)">
        <set-header name="WWW-Authenticate" exists-action="override">
          <value>Bearer error="invalid_token", resource_metadata="${gateway_url}/.well-known/oauth-protected-resource"</value>
        </set-header>
      </when>
    </choose>
    <include-fragment fragment-id="mcp-debug-error" />
  </on-error>
</policies>
