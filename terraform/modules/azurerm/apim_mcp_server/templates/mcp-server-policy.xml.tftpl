<!--
  Per-server MCP policy (attached to a NATIVE MCP-type API). Pure control flow -
  all debug tracing lives in the mcp-debug-* policy fragments (one-line includes),
  and ACL evaluation in the shared ${acl_fragment_id} fragment.

  MCP-type constraint: never read context.Response.Body (buffering breaks the MCP
  streaming pipeline). Moreover, the native MCP pipeline requires a platform-managed
  session established by an initialize that flows THROUGH it - but the hub answers
  initialize locally, so sessionless forwards die in forward-request with a 500
  ("Value cannot be null (Parameter 'source')"). Therefore BOTH tools/list and
  tools/call are answered entirely inbound via send-request; the native pipeline is
  never exercised (the MCP API type is kept for portal visibility/registry).

  Flow: hub-only gate -> validate token (shared mcp-validate-token fragment) ->
    ACL eval (shared ${acl_fragment_id} fragment) ->
    tools/list  : no match -> 403 (hub drops); else fetch backend catalog, filter,
                  cache per ACL outcome (${tools_cache_seconds}s), return bare names
    tools/call  : denied tool -> JSON-RPC -32602; optional per-user rate limit;
                  OBO-or-strip auth; inbound send-request to the backend (SSE-framed
                  responses unwrapped to the final JSON-RPC message)
    otherwise   : -32601 (the hub answers initialize/ping/notifications)

  Auth mode: ${auth}. The OBO exchange is the shared mcp-obo-exchange fragment
  (contract: oboScope set here; backendToken produced, cached per user). "pat" fills
  backendToken from the manually maintained {{mcp-pat-${server_name}}} OID->PAT map
  instead (no entry => 403, server invisible to that caller). The
  mcp-acl-${server_name} named value holds single-quoted JSON; ACL edits propagate
  in ~30s with no policy redeploy.
-->
<policies>
  <inbound>
    <base />
    <set-variable name="mcpServer" value="${server_name}" />
    <!-- Hub-only gate -->
    <choose>
      <when condition="@(context.Request.Headers.GetValueOrDefault(&quot;X-MCP-Internal-Key&quot;, &quot;&quot;) != &quot;{{mcp-hub-internal-key}}&quot;)">
        <return-response>
          <set-status code="401" reason="Unauthorized" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>{"statusCode":401,"message":"This endpoint is only reachable through the MCP hub."}</set-body>
        </return-response>
      </when>
    </choose>
    <!-- Validate the forwarded user token (defense in depth; also the OBO assertion).
         Shared mcp-validate-token fragment: sets jwt + callerOid. -->
    <include-fragment fragment-id="mcp-validate-token" />

    <!-- Parse the JSON-RPC envelope -->
    <set-variable name="rpcBody" value="@(context.Request.Body.As&lt;JObject&gt;(preserveContent: true))" />
    <set-variable name="rpcMethod" value="@((string)((JObject)context.Variables[&quot;rpcBody&quot;])[&quot;method&quot;] ?? &quot;&quot;)" />
    <set-variable name="rpcId" value="@((((JObject)context.Variables[&quot;rpcBody&quot;])[&quot;id&quot;] ?? JValue.CreateNull()).ToString(Newtonsoft.Json.Formatting.None))" />

    <!-- ACL evaluation (shared fragment: groups claim + Graph fallback + entry matching) -->
    <set-variable name="aclJson" value="@(@&quot;{{mcp-acl-${server_name}}}&quot;)" />
    <include-fragment fragment-id="${acl_fragment_id}" />
    <include-fragment fragment-id="mcp-debug-acl" />

%{ if auth == "obo" ~}
    <!-- OBO exchange (shared mcp-obo-exchange fragment; produces backendToken for
         tools/list's send-request AND tools/call's forward) -->
    <set-variable name="oboScope" value="${obo_scope}" />
    <include-fragment fragment-id="mcp-obo-exchange" />
%{ endif ~}
%{ if auth == "pat" ~}
    <!-- Per-user PAT lookup: {{mcp-pat-${server_name}}} is a manually maintained
         single-quoted JSON map of caller OID -> backend PAT (Terraform only creates
         the empty shell). No entry => 403: the hub's fan-out drops the server for
         tools/list, so callers without a PAT never see its tools (default deny).
         DEMO ONLY - production should use Key Vault-backed named values or a real
         credential broker. -->
    <set-variable name="backendToken" value="@{
        try {
            var pats = JObject.Parse(@&quot;{{mcp-pat-${server_name}}}&quot;);
            return (string)pats[(string)context.Variables[&quot;callerOid&quot;]] ?? &quot;&quot;;
        } catch (Exception) { return &quot;&quot;; }
    }" />
    <choose>
      <when condition="@((string)context.Variables[&quot;backendToken&quot;] == &quot;&quot;)">
        <return-response>
          <set-status code="403" reason="Forbidden" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>{"jsonrpc":"2.0","id":null,"error":{"code":-32602,"message":"No backend PAT registered for this caller (mcp-pat-${server_name})"}}</set-body>
        </return-response>
      </when>
    </choose>
%{ endif ~}
    <choose>
      <!-- ============ tools/list: answered entirely inbound ============ -->
      <when condition="@((string)context.Variables[&quot;rpcMethod&quot;] == &quot;tools/list&quot;)">
        <!-- No ACL match => 403; the hub's fan-out drops >=400 (default deny). -->
        <choose>
          <when condition="@(!JObject.Parse((string)context.Variables[&quot;aclResult&quot;])[&quot;matched&quot;].HasValues)">
            <return-response>
              <set-status code="403" reason="Forbidden" />
              <set-header name="Content-Type" exists-action="override">
                <value>application/json</value>
              </set-header>
              <set-body>@("{\"jsonrpc\":\"2.0\",\"id\":" + (string)context.Variables["rpcId"] + ",\"error\":{\"code\":-32602,\"message\":\"No entitlement for this MCP server\"}}")</set-body>
            </return-response>
          </when>
        </choose>
        <!-- Filtered-list cache per ACL outcome (FNV-1a; ACL edits invalidate immediately) -->
        <set-variable name="toolsCacheKey" value="@{
            var s = (string)context.Variables[&quot;aclResult&quot;];
            uint h = 2166136261;
            foreach (var c in s) { h = (h ^ (uint)c) * 16777619; }
            return &quot;${server_name}-tools-&quot; + h;
        }" />
        <cache-lookup-value key="@((string)context.Variables[&quot;toolsCacheKey&quot;])" variable-name="cachedTools" />
        <choose>
          <when condition="@(!context.Variables.ContainsKey(&quot;cachedTools&quot;))">
            <!-- Fetch the backend catalog (SSE-framed single responses unwrapped), filter, cache -->
            <send-request mode="new" response-variable-name="listResp" timeout="15" ignore-error="false">
              <set-url>${backend_url}</set-url>
              <set-method>POST</set-method>
              <set-header name="Content-Type" exists-action="override">
                <value>application/json</value>
              </set-header>
              <set-header name="Accept" exists-action="override">
                <value>application/json, text/event-stream</value>
              </set-header>
%{ if auth == "obo" || auth == "pat" ~}
              <set-header name="Authorization" exists-action="override">
                <value>@("Bearer " + (string)context.Variables["backendToken"])</value>
              </set-header>
%{ endif ~}
              <set-body>{"jsonrpc":"2.0","id":1,"method":"tools/list","params":{}}</set-body>
            </send-request>
            <set-variable name="cachedTools" value="@{
                var r = (IResponse)context.Variables[&quot;listResp&quot;];
                if (r == null || r.StatusCode &gt;= 400) { return &quot;[]&quot;; }
                var raw = r.Body.As&lt;string&gt;(preserveContent: true) ?? &quot;&quot;;
                if (raw.Contains(&quot;data:&quot;) &amp;&amp; !raw.TrimStart().StartsWith(&quot;{&quot;)) {
                    var sb = new System.Text.StringBuilder();
                    foreach (var line in raw.Split('\n')) { if (line.StartsWith(&quot;data:&quot;)) { sb.Append(line.Substring(5).Trim()); } }
                    raw = sb.ToString();
                }
                JObject parsed = null;
                try { parsed = JObject.Parse(raw); } catch (Exception) { return &quot;[]&quot;; }
                var tools = parsed[&quot;result&quot;]?[&quot;tools&quot;] as JArray; if (tools == null) { return &quot;[]&quot;; }
                var acl = JObject.Parse((string)context.Variables[&quot;aclResult&quot;]);
                var all = (bool)acl[&quot;all&quot;];
                var allow = ((JArray)acl[&quot;allow&quot;]).Select(t =&gt; (string)t).ToArray();
                var deny  = ((JArray)acl[&quot;deny&quot;]).Select(t =&gt; (string)t).ToArray();
                var kept = new JArray();
                foreach (var t in tools) {
                    var toolName = (string)t[&quot;name&quot;];
                    if (deny.Contains(toolName, StringComparer.OrdinalIgnoreCase)) { continue; }
                    if (!all &amp;&amp; !allow.Contains(toolName, StringComparer.OrdinalIgnoreCase)) { continue; }
                    kept.Add(t.DeepClone());
                }
                return kept.ToString(Newtonsoft.Json.Formatting.None);
            }" />
            <cache-store-value key="@((string)context.Variables[&quot;toolsCacheKey&quot;])" value="@((string)context.Variables[&quot;cachedTools&quot;])" duration="${tools_cache_seconds}" />
          </when>
        </choose>
        <return-response>
          <set-status code="200" reason="OK" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>@("{\"jsonrpc\":\"2.0\",\"id\":" + (string)context.Variables["rpcId"] + ",\"result\":{\"tools\":" + (string)context.Variables["cachedTools"] + "}}")</set-body>
        </return-response>
      </when>

      <!-- ============ tools/call ============ -->
      <when condition="@((string)context.Variables[&quot;rpcMethod&quot;] == &quot;tools/call&quot;)">
        <set-variable name="targetTool" value="@((string)(((JObject)context.Variables[&quot;rpcBody&quot;])[&quot;params&quot;]?[&quot;name&quot;]) ?? &quot;&quot;)" />
        <!-- Call-time ACL check: list-hiding is UX, THIS is the control. -->
        <set-variable name="callAllowed" value="@{
            var acl  = JObject.Parse((string)context.Variables[&quot;aclResult&quot;]);
            var tool = (string)context.Variables[&quot;targetTool&quot;];
            if (!acl[&quot;matched&quot;].HasValues) { return &quot;false&quot;; }
            if (((JArray)acl[&quot;deny&quot;]).Select(t =&gt; (string)t).Contains(tool, StringComparer.OrdinalIgnoreCase)) { return &quot;false&quot;; }
            if ((bool)acl[&quot;all&quot;]) { return &quot;true&quot;; }
            return ((JArray)acl[&quot;allow&quot;]).Select(t =&gt; (string)t).Contains(tool, StringComparer.OrdinalIgnoreCase) ? &quot;true&quot; : &quot;false&quot;;
        }" />
        <choose>
          <when condition="@((string)context.Variables[&quot;callAllowed&quot;] != &quot;true&quot;)">
            <!-- Audit trail (always on): denied calls are otherwise invisible -->
            <trace source="MCP" severity="information">
              <message>MCP server tools/call denied</message>
              <metadata name="mcp-server" value="${server_name}" />
              <metadata name="tool" value="@((string)context.Variables[&quot;targetTool&quot;])" />
              <metadata name="decision" value="denied" />
              <metadata name="caller-oid" value="@((string)context.Variables[&quot;callerOid&quot;])" />
            </trace>
            <return-response>
              <set-status code="200" reason="OK" />
              <set-header name="Content-Type" exists-action="override">
                <value>application/json</value>
              </set-header>
              <set-body>@("{\"jsonrpc\":\"2.0\",\"id\":" + (string)context.Variables["rpcId"] + ",\"error\":{\"code\":-32602,\"message\":\"Unknown or unauthorized tool: " + (string)context.Variables["targetTool"] + "\"}}")</set-body>
            </return-response>
          </when>
        </choose>
%{ if rate_limit_calls != null ~}
        <!-- Per-user rate limit, counted AFTER the ACL check (denied probes don't consume quota) -->
        <rate-limit-by-key calls="${rate_limit_calls}" renewal-period="${rate_limit_period}" counter-key="@(&quot;${server_name}-rl-&quot; + (string)context.Variables[&quot;callerOid&quot;])" />
%{ endif ~}
        <!-- Attribution trace (always on): consumed by the observability workbook -->
        <trace source="MCP" severity="information">
          <message>MCP tool call through APIM (OBO)</message>
          <metadata name="mcp-server" value="${server_name}" />
          <metadata name="tool" value="@((string)context.Variables[&quot;targetTool&quot;])" />
          <metadata name="decision" value="allowed" />
          <metadata name="caller-oid" value="@((string)context.Variables[&quot;callerOid&quot;])" />
          <metadata name="caller-upn" value="@(((Jwt)context.Variables[&quot;jwt&quot;]).Claims.GetValueOrDefault(&quot;preferred_username&quot;, ((Jwt)context.Variables[&quot;jwt&quot;]).Claims.GetValueOrDefault(&quot;upn&quot;, ((Jwt)context.Variables[&quot;jwt&quot;]).Claims.GetValueOrDefault(&quot;name&quot;, (string)context.Variables[&quot;callerOid&quot;]))))" />
          <metadata name="request-body" value="@(((JObject)context.Variables[&quot;rpcBody&quot;]).ToString(Newtonsoft.Json.Formatting.None))" />
        </trace>
        <!-- Forward inbound (never the native pipeline - see header). Headers are
             built from scratch: internal key never leaks, auth is OBO-or-absent. -->
        <send-request mode="new" response-variable-name="callResp" timeout="120" ignore-error="true">
          <set-url>${backend_url}</set-url>
          <set-method>POST</set-method>
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-header name="Accept" exists-action="override">
            <value>application/json, text/event-stream</value>
          </set-header>
%{ if auth == "obo" || auth == "pat" ~}
          <set-header name="Authorization" exists-action="override">
            <value>@("Bearer " + (string)context.Variables["backendToken"])</value>
          </set-header>
%{ endif ~}
          <set-body>@(((JObject)context.Variables["rpcBody"]).ToString(Newtonsoft.Json.Formatting.None))</set-body>
        </send-request>
        <return-response>
          <set-status code="200" reason="OK" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>@{
              var id = (string)context.Variables["rpcId"];
              var r = context.Variables.ContainsKey("callResp") ? (IResponse)context.Variables["callResp"] : null;
              if (r == null) { return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"error\":{\"code\":-32603,\"message\":\"Backend MCP server did not respond\"}}"; }
              var raw = r.Body.As&lt;string&gt;(preserveContent: true) ?? "";
              if (r.StatusCode &gt;= 400) {
                  var detail = raw.Length &gt; 300 ? raw.Substring(0, 300) : raw;
                  return new JObject { ["jsonrpc"] = "2.0", ["id"] = JToken.Parse(id), ["error"] = new JObject { ["code"] = -32603, ["message"] = "Backend MCP server returned HTTP " + r.StatusCode + ": " + detail } }.ToString(Newtonsoft.Json.Formatting.None);
              }
              if (!raw.TrimStart().StartsWith("{")) {
                  // SSE-framed: events split on blank lines, each event's data: lines
                  // concatenated; keep the LAST event carrying a result or error (progress
                  // notifications precede the final response).
                  string final = null;
                  foreach (var evt in raw.Replace("\r\n", "\n").Split(new[] { "\n\n" }, StringSplitOptions.RemoveEmptyEntries)) {
                      var sb = new System.Text.StringBuilder();
                      foreach (var line in evt.Split('\n')) { if (line.StartsWith("data:")) { sb.Append(line.Substring(5).Trim()); } }
                      var candidate = sb.ToString();
                      if (candidate.Length == 0) { continue; }
                      try { var o = JObject.Parse(candidate); if (o["result"] != null || o["error"] != null) { final = candidate; } } catch (Exception) { }
                  }
                  if (final != null) { return final; }
                  return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"error\":{\"code\":-32603,\"message\":\"Unparseable SSE response from backend MCP server\"}}";
              }
              return raw;
          }</set-body>
        </return-response>
      </when>

      <!-- ============ everything else: the hub answers initialize/ping/notifications ============ -->
      <otherwise>
        <return-response>
          <set-status code="200" reason="OK" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>@("{\"jsonrpc\":\"2.0\",\"id\":" + (string)context.Variables["rpcId"] + ",\"error\":{\"code\":-32601,\"message\":\"Method not supported by this server endpoint\"}}")</set-body>
        </return-response>
      </otherwise>
    </choose>
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <!-- MCP-type API: response bodies are NEVER touched here (streaming). -->
    <base />
  </outbound>
  <on-error>
    <base />
    <include-fragment fragment-id="mcp-debug-error" />
  </on-error>
</policies>
